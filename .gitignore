# dependencias y builds
# El gestor del repo es pnpm. Un package-lock.json es residuo de un `npm install`
# despistado: instala versiones distintas a las del pnpm-lock y se sube sin querer.
package-lock.json
yarn.lock
node_modules/
.next/
.astro/
dist/
.vercel/
__pycache__/
.venv/

# entorno y secretos: con commit automatico, lo que no este aqui SE SUBE
.env
.env.*
!.env.example
/env
*.pem
*.key
*.p12
credentials*.json
service-account*.json

# local de cada quien: identidad de sesion y ajustes personales de Claude Code
.sesion
.claude/settings.local.json

# estado mutable del MCP: lo cambian las acciones y se reinicia antes de cada ensayo.
# El patron cubre los de un solo uso (estado.pruebas.json de vitest, estado.humo.json de
# una corrida de humo contra un servidor aparte): ninguno es fuente de nada.
apps/mcp/estado.json
apps/mcp/estado.*.json

# ruido
*.log
.DS_Store

# material del reto (PDFs, videos): pesado y no versionable
.orca/

# documentacion interna de desarrollo (coordinacion de equipo y contexto del reto):
# no es parte del entregable publico. Nota: como estas rutas ya estaban trackeadas
# al momento de agregar el patron, git sigue versionando sus cambios (.gitignore
# no destrackea archivos existentes, solo evita volver a trackear NUEVOS archivos
# ahi). Untrackearlas de verdad (`git rm --cached`) queda pendiente hasta que el
# equipo confirme que ya no las necesita sincronizadas via git.
docs/tablero.md
docs/bitacora/
docs/issues/
docs/equipo/
docs/reto/
docs/demo/

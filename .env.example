# Copia este archivo a .env y llena los valores. .env nunca se commitea.
# Toda variable nueva entra aqui, con comentario, en el mismo commit que la usa.
# El scaffold arranca SIN llenar nada: el agente responde con una pantalla de ejemplo.

# --- Modelo del agente ----------------------------------------------------
# Principal: Gemini 3.8 Flash (ADR 0005). Respaldo: Claude Sonnet 5 (MODELO=claude).
# Nada mas en el codigo sabe cual es el modelo; solo apps/web/src/lib/agente/modelo.ts.
MODELO=gemini
# Google AI Studio (https://aistudio.google.com/apikey). Activar facturacion:
# el nivel gratuito (5-15 RPM) no alcanza para el equipo.
GOOGLE_GENERATIVE_AI_API_KEY=
# Respaldo. Consola de Anthropic. Con tope de gasto.
ANTHROPIC_API_KEY=
# Nivel de pensamiento de Gemini: low (default, latencia) | medium | high
GEMINI_THINKING=low

# --- Servidor MCP ---------------------------------------------------------
# Puerto fijo del MCP. Cambiarlo toca scripts/dev.sh, este archivo y la skill scaffold.
MCP_PUERTO=3100
# Donde lo busca el agente (apps/web). En Coolify, la URL publica con https.
MCP_URL=http://localhost:3100/mcp
# `Authorization: Bearer <token>` del MCP. Vacio = sin autenticacion (solo local).
# En el servidor desplegado NO se deja vacio.
MCP_TOKEN=
# Estado mutable que las acciones cambian. `pnpm reiniciar-estado` lo vuelve a cero.
MCP_ESTADO=apps/mcp/estado.json

# --- Datos ----------------------------------------------------------------
# Origen por defecto: los 22 CSV de db/datos cargados en memoria (ADR 0007).
# Ruta alterna a los CSV; vacio = se busca db/datos desde la raiz del repo.
DATOS_CSV=
# true cambia el origen a Postgres. Hoy avisa y usa memoria: la demo nunca depende de la red.
FEATURE_POSTGRES=false
# Postgres 17 + TimescaleDB en Coolify (docs/arquitectura/deploy.md).
# El password real esta en el panel de Coolify o en /opt/reto/.env del VPS.
# Local: postgres://reto:reto@localhost:5432/reto_banorte
DATABASE_URL=postgres://reto:CAMBIAME@157.173.204.174:5437/reto_banorte

# --- Web ------------------------------------------------------------------
# El catalogId que va en cada createSurface. Un juez puede abrir esta URL.
URL_CATALOGO=http://localhost:3000/catalogo/v1.json

# Copia este archivo a .env y llena los valores. .env nunca se commitea.
# Toda variable nueva entra aqui, con comentario, en el mismo commit que la usa.
#
# El MINIMO para que todo levante en local es DATABASE_URL (los datos) y
# GOOGLE_GENERATIVE_AI_API_KEY (el agente). Sin la base, el MCP no arranca: es a
# proposito, un MCP que contesta sin datos es peor que uno que no contesta.

# --- Datos (ADR 0010) ------------------------------------------------------
# PostgreSQL 17 del proyecto, esquema `banorte`. Es la UNICA fuente de datos: no
# hay CSV ni volcados que cargar.
#   Desde tu maquina (la instancia de Coolify, puerto publico):
#     postgres://reto:<password>@157.173.204.174:5437/reto_banorte
#   Desde otro contenedor del mismo Coolify (lo usan las apps desplegadas):
#     postgres://reto:<password>@zhgeq67vi28v6bhhgt7zjsul:5432/reto_banorte
#   Local con tu propio Postgres:
#     postgres://reto:reto@localhost:5432/reto_banorte
# El password esta en el panel de Coolify o en /opt/reto/.env del VPS.
DATABASE_URL=postgres://reto:CAMBIAME@157.173.204.174:5437/reto_banorte

# --- Modelo del agente -----------------------------------------------------
# Principal: Gemini 3.8 Flash (ADR 0005). Respaldo: Claude Sonnet 5 (MODELO=claude).
# Nada mas en el codigo sabe cual es el modelo; solo apps/web/src/lib/agente/modelo.ts.
MODELO=gemini
# Google AI Studio (https://aistudio.google.com/apikey). Sin esta llave la web
# levanta igual, pero el agente responde con una pantalla de ejemplo.
GOOGLE_GENERATIVE_AI_API_KEY=
# Respaldo. Consola de Anthropic. Con tope de gasto.
ANTHROPIC_API_KEY=
# Nivel de pensamiento de Gemini: low (default, latencia) | medium | high
GEMINI_THINKING=low

# --- Servidor MCP ----------------------------------------------------------
# Puerto fijo del MCP. Cambiarlo toca scripts/dev.sh, este archivo y la skill scaffold.
MCP_PUERTO=3100
# Donde lo busca el agente. En local, localhost; en Coolify, el alias de red interno
# (http://maya-mcp:3100/mcp): la URL publica NO es alcanzable entre contenedores.
MCP_URL=http://localhost:3100/mcp
# `Authorization: Bearer <token>` del MCP: sin esta cabecera, /mcp responde 401.
# El equipo comparte el mismo valor en local (viene en el .env que te pasaron); el
# servidor desplegado usa otro distinto. Para generar uno nuevo:
#   echo "maya_local_$(openssl rand -hex 20)"
# Vacio = sin autenticacion. No lo dejes vacio ni en local: es la misma ruta que la
# demo, y asi nadie descubre en el stand que faltaba la cabecera.
MCP_TOKEN=
# La fecha que el MCP considera "hoy". Vacio = la del movimiento mas reciente de los
# datos, que es lo que hace que "los ultimos 30 dias" tengan contenido.
MCP_HOY=

# --- Web -------------------------------------------------------------------
# El catalogId que va en cada createSurface. Un juez puede abrir esta URL.
URL_CATALOGO=http://localhost:3000/catalogo/v1.json

# --- Inicio personalizado (docs/como-funciona/inicio-personalizado.md) ------
# Un modelo chico arma la portada de cada persona con los widgets del catalogo.
# Con 0, Inicio es la pantalla programada de siempre y no corre ningun modelo.
FEATURE_INICIO_PERSONALIZADO=1
# El modelo que arma la portada. Cualquier id que la llave de arriba pueda usar
# (gemini-* con la de Google, claude-* con la de Anthropic). Es aparte del de la
# conversacion (MODELO) porque aqui no hay intencion que interpretar.
MODELO_INICIO=gemini-3.5-flash-lite
# Cada cuantos minutos el reloj revisa a los tres usuarios. Solo llama al modelo si
# algo cambio en su cuenta desde la ultima portada (una accion, movimientos nuevos).
INICIO_CADA_MINUTOS=10
# Widgets vivos (docs/como-funciona/widgets-vivos.md, ADR 0011). Con 1: cada tarjeta de
# Inicio sale de una fuente del MCP (el modelo nunca escribe cifras), y preguntarle a una
# tarjeta la cambia EN SU LUGAR en vez de rearmar el dashboard. Con 0 (default), Inicio es
# como antes. Requiere la migracion 0004 (`pnpm datos:migrar`).
FEATURE_WIDGETS_VIVOS=0
# El modelo que contesta una pregunta sobre una tarjeta. Vacio = el de MODELO_INICIO. Un
# "lite" cierra la tool en ~0.5 s; gemini-3.8-flash tardaba 7-20 s con tools (2026-09-13).
MODELO_WIDGETS=

# --- Voz (ElevenLabs, premio lateral) ---------------------------------------
# Ver docs/como-funciona/premio-elevenlabs.md. Con el flag en 0 (o vacio) el
# codigo de voz no corre: ni el boton, ni la ruta de signed-url pegan a
# ElevenLabs. NEXT_PUBLIC_ porque el boton (cliente) tambien lo necesita.
NEXT_PUBLIC_FEATURE_VOZ=0
# Consola de ElevenLabs: elevenlabs.io/app/settings/api-keys. Se usa SOLO en
# /api/voz/signed-url (servidor); nunca llega al navegador.
ELEVENLABS_API_KEY=
# Id del agente conversacional creado en elevenlabs.io/app/agents. El agente
# (voz, prompt, primer mensaje) vive en la consola de ElevenLabs, no en este
# repo: cambiarlo no toca codigo.
ELEVENLABS_AGENT_ID=

{
  "name": "@maya/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servidor MCP del dominio financiero: tools de lectura y de accion sobre los datos sinteticos.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "reiniciar-estado": "tsx scripts/reiniciar-estado.ts"
  },
  "dependencies": {
    "@maya/schemas": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}

{
  "name": "maya",
  "private": true,
  "type": "module",
  "description": "Maya — agente de salud financiera que construye la interfaz. Reto Banorte, Hack Monterrey 2026.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "scripts/dev.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "humo": "scripts/humo.sh",
    "catalogo": "pnpm --filter @maya/catalogo generar",
    "reiniciar-estado": "pnpm --filter @maya/mcp reiniciar-estado",
    "datos:generar": "node scripts/generar-datos.mjs",
    "datos:validar": "node scripts/validar-datos.mjs",
    "datos:columnas": "node scripts/verificar-orden-columnas.mjs",
    "datos:cargar": "node scripts/cargar-postgres.mjs",
    "datos:reiniciar": "node scripts/cargar-postgres.mjs --reiniciar"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.32.1"
}

{
  "name": "maya",
  "private": true,
  "type": "module",
  "description": "Maya — agente de salud financiera que construye la interfaz. Reto Banorte, Hack Monterrey 2026.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "scripts/dev.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "humo": "scripts/humo.sh",
    "catalogo": "pnpm --filter @maya/catalogo generar",
    "reiniciar-estado": "pnpm --filter @maya/mcp reiniciar-estado",
    "corridas": "node scripts/corridas.mjs",
    "datos:migrar": "node scripts/migrar.mjs",
    "datos:fixture": "node scripts/volcar-fixture.mjs",
    "datos:restaurar": "node scripts/restaurar.mjs",
    "probar-guion": "node scripts/probar-guion.mjs",
    "probar-inicio": "node scripts/probar-inicio.mjs",
    "docs:dev": "pnpm --filter @maya/docs dev",
    "docs:build": "pnpm --filter @maya/docs build",
    "docs:preview": "pnpm --filter @maya/docs preview"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.32.1"
}
